NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
OKX_ACCESS_KEY=your-okx-access-key
OKX_SECRET_KEY=your-okx-secret-key


# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard > Webhooks

# BotSubscription (TGmembership) — access-token based membership granting
# Bot username WITHOUT the @ (e.g. mentixbot)
TG_BOT_USERNAME=mentixbot
# Admin secret used to authorise POST /api/tg-bot/tokens (token upload)
ADMIN_SECRET=change_me_secret

# Course access
COURSE_ACCESS_SECRET=
COURSE_ACCESS_EMAILS=email1@example.com,email2@example.com
